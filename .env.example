# Local development settings. Copied to .env by `just setup`; .env is git-ignored.
# Everything here is optional — defaults live in config/settings/.
# DJANGO_SETTINGS_MODULE=config.settings.local  (default; leave unset so tests use config.settings.test)

# Database: SQLite file by default. Switch to Postgres with e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/project
# DATABASE_URL=sqlite:///db.sqlite3

# Celery: tasks run inline in dev unless set to false (`just dev-all` does this).
# CELERY_TASK_ALWAYS_EAGER=true
# CELERY_BROKER_URL=sqla+sqlite:///celery-broker.sqlite3
# CELERY_BROKER_URL=redis://localhost:6379/0

# allauth: mandatory | optional | none
# DJANGO_ACCOUNT_EMAIL_VERIFICATION=optional
