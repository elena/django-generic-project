# Production environment for the VPS. Copy to /srv/project/.env (chmod 600),
# referenced by the systemd units via EnvironmentFile=.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_READ_DOT_ENV_FILE=false
DJANGO_SECRET_KEY=change-me                      # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ADMIN_URL=change-me-admin/                # obscure admin path, keep trailing slash
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_SECURE_SSL_REDIRECT=False                 # Caddy already redirects to HTTPS

# Database — SQLite on persistent disk (replicated by Litestream).
# To move to Postgres: `uv add "psycopg[binary]"`, migrate data, then:
# DATABASE_URL=postgres://project:password@localhost:5432/project
DATABASE_URL=sqlite:////srv/project/data/db.sqlite3
CONN_MAX_AGE=60

# Celery — SQLite broker; switch to redis://localhost:6379/0 (and `uv add redis`) later.
CELERY_BROKER_URL=sqla+sqlite:////srv/project/data/celery-broker.sqlite3
CELERY_RESULT_BACKEND=django-db

# Cache — file based; switch to redis://localhost:6379/1 later.
CACHE_URL=filecache:///srv/project/data/cache

# Media uploads, served by Caddy at /media/
DJANGO_MEDIA_ROOT=/srv/project/data/media

# Email (SMTP URL, e.g. smtp+tls://user:password@smtp.example.com:587)
DJANGO_EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DJANGO_DEFAULT_FROM_EMAIL=project <noreply@example.com>
DJANGO_ACCOUNT_EMAIL_VERIFICATION=optional
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True

# Gunicorn
WEB_CONCURRENCY=3
